<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.local.phonetools" android:versionCode="3" android:versionName="1.2">
    <uses-sdk android:minSdkVersion="25" android:targetSdkVersion="28" />
    <!-- Reading the wallpaper for the widget's blurred background. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Tapping the widget stops other apps' background processes. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- CpuService keeps the widget updating as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <application android:label="@string/app_name" android:icon="@drawable/ic_lock" android:allowBackup="false">
        <activity android:name=".LockActivity" android:label="@string/lock" android:icon="@drawable/ic_lock"
            android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PinActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" />
        <activity android:name=".CaptureActivity" android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" android:taskAffinity="" />
        <receiver android:name=".MemWidget" android:label="@string/memory">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mem_widget" />
        </receiver>
        <service android:name=".CpuService" android:exported="false" />
        <service android:name=".SpeedService" android:label="@string/speed"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/speed_service" />
        </service>
        <receiver android:name=".AdminReceiver" android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
